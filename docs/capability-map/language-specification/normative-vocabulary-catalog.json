    "informative": {
      "paths": [
        "spec/id/README.md",
        "spec/id/editorial-guide.md",
        "spec/id/*/README.md",
        "spec/id/appendix/*.md",
        "docs/capability-map/language-specification/expected-capability-catalog.md",
        "docs/capability-map/language-specification/implementation-gap-backlog.md"
      ],
      "rule": "These documents explain, index, or audit the contract; they cannot add vocabulary or semantics."
    },
    "generated": {
      "paths": [],
      "rule": "No generated artifact is authoritative in this scope. Consumer schemas, completions, and parser tables are implementation-owned projections that must be checked against this catalog."
    },
    "checked": {
      "command": "pnpm run language-spec:check",
      "script": "scripts/check-language-spec-vocabulary.mjs",
      "rule": "The checker compares this projection with normative spec headings/sections, status labels, and the owner consumer surfaces."
    }
  },
