  "coercionContract": {
    "additive": ["number+number", "length+length", "length+unitless-number"],
    "multiplicative": ["number*number", "number*length", "length*number"],
    "divisive": ["number/number", "length/number"],
    "rejected": ["length*length", "number/length", "length+string"]
