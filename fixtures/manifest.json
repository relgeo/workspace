{
  "schemaVersion": 1,
  "compatibilityLine": "0.5",
  "fixtureRoot": "fixtures",
  "owner": "relgeo/workspace",
  "standaloneStrategy": {
    "canonicalOwner": "relgeo/workspace",
    "childRepositoryPolicy": "standalone-local-tests",
    "distribution": "not-published-as-package",
    "integrationAuthority": "workspace-root-runner"
  },
  "statusPolicy": {
    "active": "current compatibility-line baseline(s)",
    "supported-legacy": "backwards-compatibility coverage",
    "invalid": "expected parser and diagnostic failure",
    "runtime-diagnostic": "valid document with an expected post-resolve constraint violation",
    "runtime-error": "valid document with an expected post-resolve resolution error",
    "capability": "candidate coverage for a capability not yet enabled on every consumer"
  },
  "versionAcceptance": {
    "active": "0.5",
    "supportedLegacy": ["0.4"],
    "regressionOnly": ["0.1", "0.2", "0.3"],
    "unsupportedFuture": true,
    "omittedDefaultsTo": "0.5",
    "parserDiagnosticCode": "UNSUPPORTED_SPEC_VERSION"
  },
  "semanticSerialization": {
    "schema": "relgeo.resolved-scene",
    "schemaVersion": 1,
    "compatibilityLine": "0.5",
    "numberPrecision": 12,
    "negativeZero": 0,
    "undefinedFields": "omitted",
    "objectKeyOrder": "lexicographic",
    "semanticArrayOrder": "preserved",
    "replayComparator": "@relgeo/core.compareResolvedSceneReplay"
  },
  "svgSemanticSerialization": {
    "schema": "relgeo.svg-semantic",
    "schemaVersion": 1,
    "compatibilityLine": "0.5",
    "tolerance": 0.000001,
    "semanticArrayOrder": "preserved",
    "replayComparator": "@relgeo/renderer-svg.compareSVGSemanticReplay",
    "numericComparison": "absolute-difference-within-tolerance",
    "presentationBytes": "excluded-from-parity-contract"
  },
  "cliContractCoverage": {
    "input": {
      "pathPrecedence": "explicit path wins over unrelated stdin",
      "stdinMarker": "-",
      "encoding": "strict UTF-8"
    },
    "renderOptions": {
      "fixtureIds": [
        "v05-evaluator-units-candidate",
        "multi-sheet-title-block"
      ],
      "selectors": [
        "--profile",
        "--param",
        "--unit",
        "--sheet",
        "--view"
      ],
      "invalidIntent": "unknown selectors and format mismatches fail non-zero"
    },
    "output": {
      "formats": ["json", "svg", "graph"],
      "encoding": "UTF-8",
      "overwrite": "compile replaces by default; --no-overwrite refuses existing targets",
      "streams": "data on stdout; progress and diagnostics on stderr"
    }
  },
