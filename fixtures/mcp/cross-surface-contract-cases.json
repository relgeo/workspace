{
  "schemaVersion": "mcp-cross-surface-contract/v1",
  "contractRevision": "mcp-contract-2026-11-12-r1",
  "compatibilityLine": "0.5",
  "cases": [
    {
      "id": "validation-target-preserved",
      "boundary": "mcp-to-core",
      "target": "semantic",
      "expected": "typed-validation-target"
    },
    {
      "id": "shared-authoring-context",
      "boundary": "document-language-service-core-renderer",
      "expectedFields": ["documentId", "version", "requestId", "specVersion", "sourceKind"]
    },
    {
      "id": "domain-error-lossless",
      "boundary": "core-language-service-renderer-to-mcp",
      "expectedFields": ["code", "message", "severity", "origin", "phase", "path"]
    },
    {
      "id": "loopback-transport-policy",
      "boundary": "transport-adapter",
      "profile": "streamable-http-loopback",
      "expectedError": "remote-clients-rejected"
    },
    {
      "id": "host-status-redaction",
      "boundary": "host-session-security",
      "expectedFields": ["running", "endpoint", "connectedClients", "token-redacted"]
    }
  ]
}
