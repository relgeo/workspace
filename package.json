{
  "name": "relgeo-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Integration workspace for the RelGeo repositories",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "install:workspace": "pnpm install --frozen-lockfile",
    "verify:baseline": "node scripts/verify-baseline.mjs",
    "verify:baseline:strict": "node scripts/verify-baseline.mjs --strict",
    "verify:baseline:failure": "node scripts/test-baseline-failure.mjs",
    "compatibility:check": "node scripts/check-compatibility.mjs",
    "compatibility:audit": "node scripts/audit-compatibility-behavior.mjs",
    "release:audit": "node scripts/audit-release-readiness.mjs",
    "release:candidate:audit": "node scripts/audit-release-candidate.mjs",
    "release:preflight": "node scripts/run-release-preflight.mjs",
    "release:verify-published": "node scripts/verify-published-packages.mjs",
    "release:record:check": "node scripts/check-release-record.mjs",
    "conformance:fixtures": "node scripts/run-conformance-fixtures.mjs",
    "fixtures:stage:flutter": "node scripts/stage-flutter-fixtures.mjs --out=.local/flutter-fixtures",
    "flutter:conformance": "node scripts/run-flutter-conformance.mjs",
    "integration:gate": "node scripts/run-integration-gate.mjs",
    "integration:public": "node scripts/run-integration-gate.mjs --public",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm --filter relgeo-playground lint",
    "check": "pnpm --filter relgeo-docs-site check",
    "docs:build": "pnpm --filter relgeo-docs-site build",
    "playground:build": "pnpm --filter relgeo-playground build"
  }
}
